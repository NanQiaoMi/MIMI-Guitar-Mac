---
import '../styles/global.css';
import '../styles/motion.css';
import { motionStyle } from '../lib/ui/motion';
import { motionPreferenceBootstrapScript } from '../lib/ui/motionPreferences';
import { navigationEntryBootstrapScript } from '../lib/ui/navigationEntry.mjs';
import MotionRuntime from '../components/ui/MotionRuntime.svelte';
import MobileMenu from '../components/MobileMenu.svelte';
import LogoutButton from '../components/LogoutButton.svelte';
import CommandPalette from '../components/CommandPalette.svelte';
import MasterpieceIntro from '../components/ambient/MasterpieceIntro.svelte';
import FullscreenPaperWatermarks from '../components/ambient/FullscreenPaperWatermarks.svelte';
import { currentUser } from '../lib/api';
import {
  applyNavigationCachePolicy,
  getNavigationCachePolicy,
  getNavigationPrefetchAttribute,
} from '../lib/ui/navigationPolicy';

interface Props {
  title?: string;
  description?: string;
  showFooter?: boolean;
}
const {
  title = 'MIMI Guitar · 谱全了复刻 · 专业吉他谱与尤克里里谱平台',
  description = '把每一份乐谱，都当作一页书来对待。高品质吉他与尤克里里数字乐谱工坊。',
  showFooter = true,
} = Astro.props;
const user = await currentUser(Astro.cookies);
const currentPath = Astro.url.pathname;
const navigationCachePolicy = getNavigationCachePolicy({
  url: Astro.url,
  method: Astro.request.method,
  status: Astro.response.status ?? 200,
  authenticated: Boolean(user),
  hasCookie: Boolean(Astro.request.headers.get('Cookie')),
  hasSetCookie: Astro.response.headers.has('Set-Cookie'),
});
applyNavigationCachePolicy(Astro.response.headers, navigationCachePolicy);
const prefetchAttribute = (href: string) =>
  getNavigationPrefetchAttribute(href, Astro.url.href, Boolean(Astro.request.headers.get('Cookie')));
---

<!doctype html>
<html lang="zh-CN" style={motionStyle}>
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={motionPreferenceBootstrapScript} />
    <script is:inline set:html={navigationEntryBootstrapScript} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-[#fbfaf7] text-ink antialiased relative">
    <MotionRuntime client:load />
    <!-- 全屏随机纸质浮雕水印与声学共振微浮动 -->
    <FullscreenPaperWatermarks client:only="svelte" />
    <!-- 顶部悬浮胶囊导航栏 (Floating Frosted Pill Header) -->
    <header class="site-header sticky top-0 z-40 flex justify-center px-4 pt-3 sm:pt-4">
      <nav
        id="main-navbar"
        class="nav-pill flex w-full max-w-[1240px] items-center justify-between gap-3 sm:gap-6 px-4 sm:px-6 py-2.5 bg-[#ffffff]/90 border border-[#e6ded1] rounded-full shadow-[0_4px_24px_rgba(80,60,30,0.06)] backdrop-blur-xl"
      >
        <!-- Brand Logo -->
        <a href="/" data-navigation-feedback data-astro-prefetch={prefetchAttribute('/')} class="site-navigation-link group flex items-center gap-2.5 font-display text-base sm:text-lg font-bold tracking-tight text-[#2c2825] transition-colors shrink-0">
          <span class="flex h-7 w-7 sm:h-8 sm:w-8 items-center justify-center rounded-full bg-[#2c2825] text-xs font-semibold text-[#fbfaf7] shadow-sm ring-2 ring-[#c49a45]/30">
            M
          </span>
          <span class="font-serif tracking-tight text-base sm:text-lg font-bold">MIMI Guitar</span>
        </a>

        <!-- Desktop Navigation Links with Pill Segmented Control -->
        <div class="site-desktop-nav hidden xl:flex items-center gap-1 bg-[#ede5d8]/75 p-1 rounded-full border border-[#dfd6c7] text-xs font-medium shrink-0 shadow-2xs">
          <a
            href="/tabs"
            data-navigation-feedback
            data-astro-prefetch={prefetchAttribute('/tabs')}
            aria-current={currentPath.startsWith('/tabs') ? 'page' : undefined}
            class={`rounded-full px-4 py-1.5 whitespace-nowrap transition-all font-serif ${
              currentPath.startsWith('/tabs')
                ? 'bg-[#2c2825] text-[#fbfaf7] font-bold shadow-xs'
                : 'text-[#705c42] hover:text-[#2c2825] hover:bg-[#ffffff]/60'
            }`}
          >
            吉他谱
          </a>
          <a
            href="/ukulele"
            data-navigation-feedback
            data-astro-prefetch={prefetchAttribute('/ukulele')}
            aria-current={currentPath.startsWith('/ukulele') ? 'page' : undefined}
            class={`rounded-full px-4 py-1.5 whitespace-nowrap transition-all font-serif ${
              currentPath.startsWith('/ukulele')
                ? 'bg-[#2c2825] text-[#fbfaf7] font-bold shadow-xs'
                : 'text-[#705c42] hover:text-[#2c2825] hover:bg-[#ffffff]/60'
            }`}
          >
            尤克里里
          </a>
          <a
            href="/studio"
            data-navigation-feedback
            aria-current={currentPath.startsWith('/studio') ? 'page' : undefined}
            class={`rounded-full px-4 py-1.5 whitespace-nowrap transition-all flex items-center gap-1.5 font-serif ${
              currentPath.startsWith('/studio')
                ? 'bg-[#2c2825] text-[#fbfaf7] font-bold shadow-xs'
                : 'text-[#705c42] hover:text-[#2c2825] hover:bg-[#ffffff]/60'
            }`}
          >
            <span>制谱工坊</span>
            <span class={`inline-flex items-center px-1.5 py-0.2 rounded-full text-[9px] font-mono font-bold ${
              currentPath.startsWith('/studio') ? 'bg-[#c49a45] text-[#ffffff]' : 'bg-[#c49a45]/15 text-[#966b1a] border border-[#c49a45]/30'
            }`}>PRO</span>
          </a>
          <a
            href="/article"
            data-navigation-feedback
            data-astro-prefetch={prefetchAttribute('/article')}
            aria-current={currentPath.startsWith('/article') ? 'page' : undefined}
            class={`rounded-full px-4 py-1.5 whitespace-nowrap transition-all font-serif ${
              currentPath.startsWith('/article')
                ? 'bg-[#2c2825] text-[#fbfaf7] font-bold shadow-xs'
                : 'text-[#705c42] hover:text-[#2c2825] hover:bg-[#ffffff]/60'
            }`}
          >
            专栏文章
          </a>
          <a href="/practice" data-navigation-feedback aria-current={currentPath.startsWith('/practice') ? 'page' : undefined} class={`rounded-full px-2.5 py-1.5 whitespace-nowrap font-serif transition-colors ${currentPath.startsWith('/practice') ? 'bg-[#2c2825] text-[#fbfaf7]' : 'text-[#705c42] hover:bg-[#ffffff]/60 hover:text-[#2c2825]'}`}>我的练习</a>
          <a href="/library" data-navigation-feedback aria-current={currentPath.startsWith('/library') ? 'page' : undefined} class={`rounded-full px-2.5 py-1.5 whitespace-nowrap font-serif transition-colors ${currentPath.startsWith('/library') ? 'bg-[#2c2825] text-[#fbfaf7]' : 'text-[#705c42] hover:bg-[#ffffff]/60 hover:text-[#2c2825]'}`}>我的谱</a>
          <a href="/settings/data" data-navigation-feedback aria-current={currentPath.startsWith('/settings/data') ? 'page' : undefined} class={`rounded-full px-2.5 py-1.5 whitespace-nowrap font-serif transition-colors ${currentPath.startsWith('/settings/data') ? 'bg-[#2c2825] text-[#fbfaf7]' : 'text-[#705c42] hover:bg-[#ffffff]/60 hover:text-[#2c2825]'}`}>备份</a>
        </div>

        <!-- Right: Search Capsule & Quick Actions -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <!-- Search Input Trigger -->
          <button
            type="button"
            id="nav-search-trigger"
            class="flex min-h-[44px] min-w-[44px] items-center gap-2 w-[44px] min-[380px]:w-28 sm:w-44 xl:w-52 rounded-full border border-[#dfd6c7] bg-[#f7f3eb]/80 pl-3.5 pr-2.5 py-1.5 text-xs text-[#8c7b68] transition-colors hover:bg-[#ffffff] hover:border-[#c49a45] hover:text-[#2c2825] cursor-pointer shadow-2xs shrink-0"
            aria-label="打开搜索与命令面板 (⌘K)"
          >
            <svg class="h-3.5 w-3.5 text-[#8c7b68] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span class="hidden min-[380px]:block flex-1 text-left truncate font-serif">搜索曲谱...</span>
            <kbd class="hidden sm:inline-block rounded-md border border-[#dfd6c7] bg-[#ffffff] px-1.5 py-0.5 text-[10px] font-mono text-[#8c7b68] shadow-2xs font-bold">
              ⌘K
            </kbd>
          </button>

          <!-- Upload Dropdown -->
          <div class="group relative hidden sm:block shrink-0">
            <a
              href="/upload"
              data-navigation-feedback
              class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-[#ede5d8]/80 hover:bg-[#ede5d8] border border-[#dfd6c7] text-xs font-serif font-bold text-[#5c4a38] hover:text-[#2c2825] transition-all shadow-2xs shrink-0"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <span>上传</span>
            </a>
            <div class="invisible absolute right-0 top-full z-50 mt-2 w-48 rounded-2xl border border-[#e2d7c5] bg-[#ffffff]/98 p-2 opacity-0 shadow-2xl backdrop-blur-xl transition-all duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 text-xs font-serif">
              <a href="/upload?type=guitar" class="flex items-center gap-2 rounded-xl px-3 py-2 text-[#2c2825] hover:bg-[#f5efe6] transition">
                <span class="h-1.5 w-1.5 rounded-full bg-[#c49a45]"></span>
                吉他谱 (GP / MusicXML)
              </a>
              <a href="/upload?type=ukulele" class="flex items-center gap-2 rounded-xl px-3 py-2 text-[#2c2825] hover:bg-[#f5efe6] transition">
                <span class="h-1.5 w-1.5 rounded-full bg-[#c49a45]"></span>
                尤克里里谱
              </a>
            </div>
          </div>

          <!-- Replay Masterpiece Cinema Intro Icon Button -->
          {currentPath === '/' && (
            <button
              type="button"
              id="nav-play-intro-btn"
              class="hidden xl:flex h-[44px] w-[44px] min-h-[44px] min-w-[44px] rounded-full bg-[#ede5d8]/60 hover:bg-[#ede5d8] border border-[#dfd6c7] text-[#705c42] hover:text-[#2c2825] items-center justify-center text-xs transition-colors cursor-pointer"
              title="重新播放 纸质书卷开卷大片"
              aria-label="重新播放纸质书卷开卷大片"
            >
              📖
            </button>
          )}

          <!-- Mobile Menu Trigger -->
          <div class="flex xl:hidden shrink-0">
            <MobileMenu client:load user={Boolean(user)} />
          </div>
        </div>
      </nav>
    </header>

    <main class="flex-1 w-full relative">
      <slot />
    </main>

    <!-- Masterpiece Cinema Opening & Ambient Audio (仅在首页首次加载时展现) -->
    {currentPath === '/' && <MasterpieceIntro client:load />}

    <!-- 全局快捷命令面板 Command Palette (⌘K) -->
    <CommandPalette client:load />

    <script>
      import { installNavigationFeedbackRuntime } from '../lib/ui/navigationRuntime';

      installNavigationFeedbackRuntime(document);

      const navActionBoundKey = 'mimiBaseNavActionsBound';
      if (document.documentElement.dataset[navActionBoundKey] !== 'true') {
        document.documentElement.dataset[navActionBoundKey] = 'true';
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          if (target.closest('#nav-search-trigger')) {
            window.dispatchEvent(new Event('open-command-palette'));
            return;
          }

          if (target.closest('#nav-play-intro-btn')) {
            window.dispatchEvent(new Event('mimi:play-intro'));
          }
        });
      }
    </script>

    <!-- 极简书卷页脚 (Minimal Craft Footer) -->
    {showFooter && (
      <footer class="w-full bg-[#f7f3eb]/90 border-t border-[#e8dfd2] py-8 text-center text-xs font-serif text-[#8c7b68] select-none">
        <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-2">
            <span class="font-bold text-[#2c2825]">MIMI Guitar</span>
            <span>· 纸本墨韵 · 专业数字乐谱工坊</span>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-[11px] text-[#705c42]">
            <a href="/tabs" data-navigation-feedback data-astro-prefetch={prefetchAttribute('/tabs')} class="site-navigation-link hover:text-[#2c2825] transition">吉他曲库</a>
            <a href="/ukulele" data-navigation-feedback data-astro-prefetch={prefetchAttribute('/ukulele')} class="site-navigation-link hover:text-[#2c2825] transition">尤克里里</a>
            <a href="/studio" data-navigation-feedback class="site-navigation-link hover:text-[#2c2825] transition">制谱工坊</a>
            <a href="/article" data-navigation-feedback data-astro-prefetch={prefetchAttribute('/article')} class="site-navigation-link hover:text-[#2c2825] transition">专栏</a>
            <a href="/practice" data-navigation-feedback class="site-navigation-link hover:text-[#2c2825] transition">我的练习</a>
            <a href="/library" data-navigation-feedback class="site-navigation-link hover:text-[#2c2825] transition">我的谱</a>
            <a href="/settings/data" data-navigation-feedback class="site-navigation-link hover:text-[#2c2825] transition">数据与备份</a>
            <a href="/motion" data-navigation-feedback class="site-navigation-link hover:text-[#2c2825] transition">交互体验</a>
          </div>
          <div class="text-[10px] text-[#a89b8a]">
            © {new Date().getFullYear()} MIMI Guitar. All rights reserved.
          </div>
        </div>
      </footer>
    )}
  </body>
</html>
