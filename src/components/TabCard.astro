---
interface Props {
  tab: any;
  staggerIndex?: number;
  featured?: boolean;
}
const { tab, staggerIndex = 0, featured = false } = Astro.props;
const cat = tab.category === 'ukulele' ? 'ukulele' : 'tabs';
const diffMap = [null, '零基础', '初级', '中级', '高级', '专业'];
const diff = diffMap[tab.difficulty] ?? '初级';
const formMap: Record<number, string> = { 1: '弹唱谱', 2: '指弹谱', 3: '和弦谱', 4: '六线谱' };
const form = formMap[tab.sheetForm] ?? '六线谱';
const heat = tab.heat >= 10000 ? (tab.heat / 10000).toFixed(1) + '万' : String(tab.heat ?? 0);
const title = tab.title ?? '未命名曲谱';
const artist = tab.artist ?? '未知歌手';
const key = tab.key ?? 'G';

// 根据曲名哈希选择朱砂水印字样
const seals = ['谱', '音', '琴', '吉', '韵', '和'];
const sealChar = seals[(title.charCodeAt(0) || 0) % seals.length];
---

<a
  href={`/${cat}/${tab.id}`}
  class="group relative flex items-center gap-4 sm:gap-5 p-4 rounded-3xl border border-[#e8e2d4] bg-[#fbf9f4] shadow-[0_2px_12px_rgba(76,59,43,0.03)] transition-all duration-300 hover:-translate-y-1 hover:border-[#c49a45]/60 hover:bg-[#fffdfa] hover:shadow-[0_8px_24px_rgba(196,154,69,0.12)] animate-stagger-in overflow-hidden"
  style={`animation-delay: ${Math.min(staggerIndex * 40, 400)}ms;`}
>
  <!-- 纸卷手绘质感封面缩略图 / 真实乐谱截图 (Procedural Manuscript Miniature + Real Screenshot Layer) -->
  <div class="relative flex h-20 w-20 sm:h-24 sm:w-24 shrink-0 flex-col justify-between p-2 rounded-2xl border border-[#e2d8c3] bg-[#f5efe3] shadow-2xs overflow-hidden transition-all duration-300 group-hover:border-[#c49a45]/60 group-hover:bg-[#fbf6ec]">
    <!-- 羊皮纸底层纹理与声学六线谱简笔（基础手绘占位底图） -->
    <div class="pointer-events-none absolute inset-0 opacity-20 bg-[radial-gradient(#8c7b68_1px,transparent_1px)] [background-size:8px_8px]" />

    <!-- 顶部 TAB 标识与调性 -->
    <div class="flex items-center justify-between z-10">
      <span class="text-[9px] font-mono font-bold tracking-widest text-[#8c7b68]">TAB</span>
      <span class="text-[10px] font-display font-semibold text-[#a88942] bg-[#fdfaf3] px-1.5 py-0.2 rounded border border-[#e0d6c0]">
        {key}调
      </span>
    </div>

    <!-- 中间手绘六线谱线与品位音符切片 -->
    <div class="space-y-1 my-auto z-10 opacity-70 group-hover:opacity-90 transition-opacity">
      <div class="h-[1px] w-full bg-[#8c7b68]/40 relative flex justify-around text-[7px] font-mono text-[#5c4a38] leading-none">
        <span>0</span><span>2</span><span>3</span>
      </div>
      <div class="h-[1px] w-full bg-[#8c7b68]/30 relative flex justify-around text-[7px] font-mono text-[#5c4a38] leading-none">
        <span>0</span><span>2</span><span>0</span>
      </div>
      <div class="h-[1px] w-full bg-[#8c7b68]/40 relative flex justify-around text-[7px] font-mono text-[#5c4a38] leading-none">
        <span>3</span><span>0</span><span>2</span>
      </div>
    </div>

    <!-- 底部朱砂篆刻印章微水印 -->
    <div class="flex items-center justify-between z-10">
      <span class="text-[8px] font-serif text-[#8c7b68] truncate max-w-[40px]">{form}</span>
      <div class="w-4 h-4 rounded-sm border border-[#c84b31]/50 bg-[#c84b31]/10 flex items-center justify-center text-[#c84b31] text-[8px] font-serif font-bold shadow-3xs">
        {sealChar}
      </div>
    </div>

    <!-- 真实乐谱高清截图（若加载成功平滑覆盖，若失败自动隐藏露出底图） -->
    {tab.screenshotUrl && (
      <img
        src={tab.screenshotUrl}
        alt={title}
        class="absolute inset-0 h-full w-full object-cover z-20 transition-transform duration-500 ease-out group-hover:scale-108"
        loading="lazy"
        onerror="this.style.display='none'"
      />
    )}
  </div>

  <!-- 卡片内容信息 -->
  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-2">
      <h3 class="truncate font-display text-base sm:text-lg font-semibold text-[#2c241b] transition-colors duration-200 group-hover:text-[#966b26]">
        {title}
      </h3>
      <!-- 热度焰火徽章 -->
      <span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-[#e8e2d4] bg-white/80 px-2 py-0.5 text-xs font-mono font-medium text-[#705c42] shadow-2xs group-hover:border-[#c49a45]/40">
        <span class="text-[#c84b31] text-[11px]">🔥</span>
        {heat}
      </span>
    </div>

    <!-- 歌手名 -->
    <p class="mt-0.5 truncate text-xs text-[#8c7b68] font-serif">
      {artist}
    </p>

    <!-- 乐理标签胶囊群组 (Key / Form / Difficulty) -->
    <div class="mt-2.5 flex flex-wrap items-center gap-1.5 text-xs">
      <!-- 调性 -->
      <span class="inline-flex items-center rounded-full border border-[#e2d8c3] bg-white/80 px-2 py-0.5 text-[#5c4a38] font-medium font-serif">
        {key} 调
      </span>

      <!-- 谱型 -->
      <span class="inline-flex items-center rounded-full border border-[#e2d8c3] bg-white/80 px-2 py-0.5 text-[#5c4a38] font-medium font-serif">
        {form}
      </span>

      <!-- 难度星级 -->
      {diff && (
        <span class="inline-flex items-center gap-1 rounded-full border border-[#e2d8c3] bg-white/80 px-2 py-0.5 text-[#5c4a38] font-medium font-serif">
          <span class="h-1.5 w-1.5 rounded-full bg-[#c49a45]"></span>
          {diff}
        </span>
      )}

      <!-- 悬浮箭头指示 -->
      <span class="ml-auto hidden sm:inline-flex items-center gap-1 text-xs font-medium text-[#966b26] opacity-0 -translate-x-1.5 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0">
        <span>研习</span>
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </span>
    </div>
  </div>
</a>