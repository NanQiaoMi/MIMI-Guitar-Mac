---
import Base from '../layouts/Base.astro';
import PersonalLibrary from '../components/PersonalLibrary.svelte';
---

<Base title="我的谱 · MIMI Guitar">
  <section class="mx-auto my-6 max-w-[1240px] space-y-6 px-4 sm:my-10 sm:px-6">
    <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between border-b border-[#ebd8bc]/50 pb-5">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 rounded-full bg-[#f5ede0] px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-[#8c6d46]">
          <span class="inline-block h-2 w-2 rounded-full bg-[#3E885B]"></span>
          <span>LOCAL VAULT · 本设备个人资料</span>
        </div>
        <h1 class="font-display text-heading text-[#1a1816]">我的谱</h1>
        <p class="max-w-2xl text-sm leading-6 text-ash">
          收藏、待练、自制曲谱与练习数据安全保存在本地。支持直接导入 GP / IBE / XHE 格式并随时导出备份。
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a href="/studio" class="btn btn-ghost h-9 !px-3.5 text-xs font-medium">制谱工坊</a>
        <a href="/settings/data" class="btn btn-ghost h-9 !px-3.5 text-xs font-medium">数据管理</a>
      </div>
    </header>
    <PersonalLibrary client:load />
  </section>
</Base>
