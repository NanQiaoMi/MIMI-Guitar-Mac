---
import Base from '../../layouts/Base.astro';
import { db } from '../../lib/db';
import { DEMO_ARTICLES } from '../../lib/demoData';
import { CatalogReadUnavailableError, withCatalogRead } from '../../lib/catalogReadGate';

const { id } = Astro.params;
let article: any = null;
let isDemoArticle = false;
let catalogUnavailable = false;

try {
  article = await withCatalogRead(() => db.article.findUnique({ where: { id: id ?? '' } }));
} catch (error) {
  catalogUnavailable = error instanceof CatalogReadUnavailableError;
}

if (!article) {
  article = DEMO_ARTICLES.find((a) => a.id === id) ?? null;
  isDemoArticle = Boolean(article);
}

if (!article) {
  return new Response(
    catalogUnavailable
      ? '文章曲库暂时不可用，当前无法确认这篇文章。请稍后重试。'
      : '未找到这篇文章。请检查文章编号，或返回文章列表重新选择。',
    {
      status: catalogUnavailable ? 503 : 404,
      headers: {
        'content-type': 'text/plain; charset=utf-8',
        'cache-control': 'no-store',
      },
    }
  );
}

// Find related articles (excluding current and temporary test articles)
const relatedArticles = DEMO_ARTICLES.filter(
  (a) => a.id !== id && !a.title.startsWith('测试文章') && !a.title.startsWith('M7 验收文章')
).slice(0, 3);

// Map diagram based on article ID
const diagramMap: Record<string, { src: string; caption: string }> = {
  'art-player': {
    src: '/images/tutorials/player-guide-diagram.svg',
    caption: 'FIG. 01 · 交互播放器四大交互视窗协同体系结构',
  },
  'art-studio': {
    src: '/images/tutorials/studio-workflow-diagram.svg',
    caption: 'FIG. 02 · 制谱工坊 PRO 工作台与全键盘驱动体系',
  },
  'art-tab': {
    src: '/images/tutorials/tab-reading-diagram.svg',
    caption: 'FIG. 03 · 吉他六线谱（TAB）物理映射与技巧符号解构',
  },
  'art-capo': {
    src: '/images/tutorials/capo-chart-diagram.svg',
    caption: 'FIG. 04 · 变调夹（Capo）常用定调换算速查表',
  },
};

const diagram = diagramMap[article.id] ?? null;

function heatText(v: number): string {
  if (v >= 10000) return (v / 10000).toFixed(1) + '万';
  return String(v);
}

// Helper to choose contextual icon for H2 sections
function h2Icon(title: string): string {
  if (title.includes('快捷键') || title.includes('键盘') || title.includes('按键')) return '⌨️';
  if (title.includes('流程') || title.includes('指引') || title.includes('上手') || title.includes('步骤')) return '📋';
  if (title.includes('和弦') || title.includes('调式') || title.includes('乐理')) return '🎵';
  if (title.includes('六线谱') || title.includes('TAB') || title.includes('琴弦')) return '🎸';
  if (title.includes('变调夹') || title.includes('Capo') || title.includes('横按')) return '🔧';
  if (title.includes('攻坚') || title.includes('练习') || title.includes('片段')) return '🚩';
  if (title.includes('？') || title.includes('?') || title.includes('为什么')) return '❓';
  if (title.includes('符号') || title.includes('解构') || title.includes('准则')) return '📖';
  return '📌';
}

function parseStep(h3Text: string): { isStep: boolean; step: string; title: string; icon: string } {
  if (h3Text.startsWith('第') && h3Text.includes('步')) {
    const parts = h3Text.split('：');
    const step = parts[0];
    const title = parts.slice(1).join('：');
    let icon = '⭐️';
    if (step.includes('一') || step.includes('1')) icon = '⚙️';
    else if (step.includes('二') || step.includes('2')) icon = '⌨️';
    else if (step.includes('三') || step.includes('3')) icon = '🎹';
    else if (step.includes('四') || step.includes('4')) icon = '📝';
    return { isStep: true, step, title, icon };
  }
  const match = h3Text.match(/^(\d+)\.\s*(.*)/);
  if (match) {
    const num = match[1];
    const title = match[2];
    let icon = '⭐️';
    if (num === '1') icon = '✂️';
    else if (num === '2') icon = '📈';
    else if (num === '3') icon = '⏱️';
    return { isStep: true, step: `步骤 ${num}`, title, icon };
  }
  return { isStep: false, step: '', title: h3Text, icon: '' };
}

function parseListItem(raw: string, level: number) {
  let s = raw.trim();
  const boldMatch = s.match(/^\*\*([^*]+)\*\*[:：]?\s*(.*)/);
  if (boldMatch) {
    return { level, term: boldMatch[1], body: boldMatch[2] };
  }
  return { level, term: null, body: s };
}

// Robust line-by-line Markdown block parser
function parseMarkdown(text: string) {
  const lines = text.split('\n');
  const blocks: any[] = [];
  let i = 0;
  const n = lines.length;

  while (i < n) {
    const line = lines[i];
    const trimmed = line.trim();

    if (!trimmed) {
      i++;
      continue;
    }

    if (trimmed === '---') {
      blocks.push({ type: 'divider' });
      i++;
      continue;
    }

    if (trimmed.startsWith('# ')) {
      blocks.push({ type: 'h1', text: trimmed.slice(2).trim() });
      i++;
      continue;
    }

    if (trimmed.startsWith('## ')) {
      const h2Text = trimmed.slice(3).trim();
      blocks.push({ type: 'h2', text: h2Text, icon: h2Icon(h2Text) });
      i++;
      continue;
    }

    if (trimmed.startsWith('### ')) {
      const h3Text = trimmed.slice(4).trim();
      const stepInfo = parseStep(h3Text);
      if (stepInfo.isStep) {
        blocks.push({ type: 'step', step: stepInfo.step, title: stepInfo.title, icon: stepInfo.icon });
      } else {
        blocks.push({ type: 'h3', text: h3Text });
      }
      i++;
      continue;
    }

    if (trimmed.startsWith('>')) {
      const calloutLines: string[] = [];
      while (i < n && lines[i].trim().startsWith('>')) {
        let l = lines[i].trim();
        while (l.startsWith('>')) {
          l = l.slice(1).trim();
        }
        if (l) calloutLines.push(l);
        i++;
      }
      let isTip = false;
      let title = '重要说明';
      let startIdx = 0;
      if (calloutLines.length > 0) {
        if (calloutLines[0].startsWith('[!TIP]')) {
          isTip = true;
          title = calloutLines[0].replace('[!TIP]', '').trim() || '琴房手账贴士';
          startIdx = 1;
        } else if (calloutLines[0].startsWith('[!NOTE]')) {
          isTip = false;
          title = calloutLines[0].replace('[!NOTE]', '').trim() || '重要说明';
          startIdx = 1;
        }
      }
      blocks.push({
        type: isTip ? 'tip' : 'note',
        title,
        lines: calloutLines.slice(startIdx)
      });
      continue;
    }

    if (trimmed.startsWith('|') && trimmed.includes('|')) {
      const tableLines: string[] = [];
      while (i < n && lines[i].trim().startsWith('|')) {
        tableLines.push(lines[i].trim());
        i++;
      }
      const parseRow = (l: string) => l.replace(/^\|/, '').replace(/\|$/, '').split('|').map(c => c.trim());
      if (tableLines.length >= 2) {
        const headers = parseRow(tableLines[0]);
        const rows: string[][] = [];
        for (let rowIdx = 1; rowIdx < tableLines.length; rowIdx++) {
          if (tableLines[rowIdx].includes('---')) continue;
          rows.push(parseRow(tableLines[rowIdx]));
        }
        blocks.push({ type: 'table', headers, rows });
      }
      continue;
    }

    if (trimmed.startsWith('- ') || trimmed.startsWith('* ')) {
      const items: any[] = [];
      while (i < n) {
        const cur = lines[i];
        const t = cur.trim();
        if (!t) {
          if (i + 1 < n && (lines[i+1].trim().startsWith('- ') || lines[i+1].trim().startsWith('* '))) {
            i++;
            continue;
          } else {
            break;
          }
        }
        if (t.startsWith('- ') || t.startsWith('* ')) {
          const indent = cur.search(/\S/);
          const level = indent >= 2 ? 1 : 0;
          const c = t.slice(2).trim();
          items.push(parseListItem(c, level));
          i++;
        } else {
          break;
        }
      }
      blocks.push({ type: 'list', items });
      continue;
    }

    // Normal paragraph
    const pLines: string[] = [];
    while (i < n) {
      const cur = lines[i];
      const t = cur.trim();
      if (!t || t === '---' || t.startsWith('#') || t.startsWith('>') || t.startsWith('|') || t.startsWith('- ') || t.startsWith('* ')) {
        break;
      }
      pLines.push(t);
      i++;
    }
    if (pLines.length > 0) {
      blocks.push({ type: 'p', text: pLines.join('\n') });
    }
  }
  return blocks;
}

function formatInlineHtml(str: string): string {
  return str
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/`([^`]+)`/g, '<kbd class="inline-block px-1.5 py-0.5 rounded border border-[#D0C8BA] bg-white font-mono text-xs font-bold text-[#332B24] shadow-2xs">$1</kbd>');
}

const blocks = parseMarkdown(article.content);
---

<Base title={`${article.title} - MIMI Guitar 琴房专栏`}>
  <div class="max-w-4xl mx-auto py-6">
    <!-- Top Return & Action Bar -->
    <div class="flex items-center justify-between gap-4 mb-6 text-xs">
      <a href="/article" class="btn text-xs py-1.5 inline-flex items-center gap-1.5">
        <span>←</span>
        <span>返回文章列表</span>
      </a>

      <span class="font-serif font-semibold text-[#8A7151]">纸本琴声 · 琴房墨卷</span>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="copy-title-btn"
          data-title={article.title}
          class="px-3 py-1.5 rounded-lg border border-[#E5DDD0] bg-white text-[#584A3B] hover:bg-[#FBF8F2] transition"
        >
          复制标题
        </button>
      </div>
    </div>

    <!-- Main Manuscript Book Page Container -->
    <article class="p-6 sm:p-12 rounded-3xl bg-[#FEFFFC] border-1.5 border-[#D8CEBD] shadow-sm relative overflow-hidden">
      <!-- Decorative Book Spine Stitch Accents -->
      <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-[#C49A45] via-[#C84B31] to-[#C49A45] opacity-40"></div>

      <!-- Article Header -->
      <header class="border-b border-[#E5DDD0] pb-8 mb-8">
        {isDemoArticle && (
          <p class="mb-3 inline-flex rounded-lg border border-amber-300 bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-800">
            内置演示文章 · 曲库离线回退
          </p>
        )}

        <div class="flex flex-wrap items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-[#C84B31]/10 text-[#C84B31] border border-[#C84B31]/20">
              {article.category ?? '软件教程'}
            </span>
            <span class="font-mono text-[#8C7C6B]">
              出刊日期: {article.createdAt.toISOString().slice(0, 10)}
            </span>
          </div>

          <span class="font-mono text-[#6E5D48] text-xs">
            已阅览 {heatText(article.views)} 次 · MIMI 琴房编配组
          </span>
        </div>

        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-[#24201D] mt-4 leading-tight">
          {article.title}
        </h1>

        <!-- Double ornamental divider -->
        <div class="space-y-0.5 mt-6">
          <div class="h-0.5 bg-[#E5DDD0]"></div>
          <div class="h-px bg-[#F0E9DE]"></div>
        </div>
      </header>

      <!-- Embedded Vector Illustration / Diagram (if available for this tutorial) -->
      {diagram && (
        <div class="my-8 p-4 sm:p-6 rounded-2xl bg-[#F8F5EE] border border-[#E2DACD] shadow-2xs">
          <img
            src={diagram.src}
            alt={article.title}
            class="w-full h-auto rounded-xl border border-[#E5DDD0] shadow-xs"
            loading="eager"
          />
          <p class="mt-3 text-center font-mono text-xs font-bold text-[#8A7151]">
            {diagram.caption}
          </p>
        </div>
      )}

      <!-- Structured Markdown Body -->
      <div class="space-y-6 text-[#584A3B]">
        {blocks.map((block) => {
          if (block.type === 'divider') {
            return (
              <div class="flex items-center gap-3 my-8">
                <div class="flex-1 h-px bg-[#F0E9DE]"></div>
                <span class="text-xs text-[#8C7C6B] font-serif">❖ ❖ ❖</span>
                <div class="flex-1 h-px bg-[#F0E9DE]"></div>
              </div>
            );
          }
          if (block.type === 'h1') {
            return (
              <div class="pt-6 pb-2">
                <h2 class="font-display text-2xl sm:text-3xl font-bold text-[#24201D]">
                  {block.text}
                </h2>
                <div class="w-12 h-1 bg-[#C49A45] rounded-full mt-2"></div>
              </div>
            );
          }
          if (block.type === 'h2') {
            return (
              <div class="pt-6 flex items-center gap-2.5">
                <span class="w-1.5 h-5 rounded-full bg-[#C84B31]"></span>
                <span class="text-lg">{block.icon}</span>
                <h3 class="font-display text-xl sm:text-2xl font-bold text-[#24201D]">
                  {block.text}
                </h3>
              </div>
            );
          }
          if (block.type === 'step') {
            return (
              <div class="pt-4 flex items-center gap-3">
                <span class="px-2.5 py-1 rounded-md text-xs font-bold font-mono bg-[#C84B31]/10 text-[#C84B31] border border-[#C84B31]/25 inline-flex items-center gap-1.5">
                  <span>{block.icon}</span>
                  <span>{block.step}</span>
                </span>
                {block.title && (
                  <h4 class="font-display text-base sm:text-lg font-bold text-[#24201D]">
                    {block.title}
                  </h4>
                )}
              </div>
            );
          }
          if (block.type === 'h3') {
            return (
              <h4 class="font-display text-lg font-bold text-[#6E5D48] pt-2">
                {block.text}
              </h4>
            );
          }
          if (block.type === 'table') {
            return (
              <div class="my-6 overflow-x-auto rounded-xl border border-[#DDD4C5] shadow-2xs">
                <table class="w-full text-left border-collapse bg-white">
                  <thead>
                    <tr class="bg-[#F2ECE1] border-b border-[#E2DACD]">
                      {block.headers.map((h: string) => (
                        <th class="py-3 px-4 font-display text-xs sm:text-sm font-bold text-[#3D3225]">
                          {h}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {block.rows.map((row: string[], rIdx: number) => (
                      <tr class={`border-b border-[#EBE4D8]/70 ${rIdx % 2 === 1 ? 'bg-[#FBF9F5]' : 'bg-white'}`}>
                        {row.map((cell: string) => (
                          <td class="py-3 px-4 text-xs sm:text-sm text-[#44382C]">
                            <span set:html={formatInlineHtml(cell)} />
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            );
          }
          if (block.type === 'list') {
            return (
              <ul class="space-y-2.5 my-3">
                {block.items.map((item: any) => (
                  <li class={`flex items-start gap-2 text-sm sm:text-base text-[#44382C] ${item.level > 0 ? 'ml-6' : ''}`}>
                    {item.level === 0 ? (
                      <span class="text-[#C49A45] text-xs mt-1">❖</span>
                    ) : (
                      <span class="text-[#8A7151] font-bold text-xs mt-0.5">–</span>
                    )}
                    <div class="flex-1">
                      {item.term ? (
                        <div>
                          <strong class="font-display font-bold text-[#24201D] block sm:inline mr-1">{item.term}：</strong>
                          <span set:html={formatInlineHtml(item.body)} />
                        </div>
                      ) : (
                        <span set:html={formatInlineHtml(item.body)} />
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            );
          }
          if (block.type === 'tip') {
            return (
              <div class="p-5 rounded-xl bg-[#FFFBEA] border border-[#E8DEB5] shadow-2xs flex items-start gap-3 my-4">
                <span class="text-base text-[#C49A45] mt-0.5">💡</span>
                <div class="space-y-1.5 flex-1">
                  <p class="text-xs font-bold text-[#8A7151]">{block.title}</p>
                  {block.lines.map((line: string) => (
                    <p class="font-serif text-sm leading-relaxed text-[#584A3B]">
                      <span set:html={formatInlineHtml(line)} />
                    </p>
                  ))}
                </div>
              </div>
            );
          }
          if (block.type === 'note') {
            return (
              <div class="p-5 rounded-xl bg-[#F3F9FC] border border-[#D0E5F0] shadow-2xs flex items-start gap-3 my-4">
                <span class="text-base text-[#2E6B8A] mt-0.5">ℹ️</span>
                <div class="space-y-1.5 flex-1">
                  <p class="text-xs font-bold text-[#2E6B8A]">{block.title}</p>
                  {block.lines.map((line: string) => (
                    <p class="font-serif text-sm leading-relaxed text-[#584A3B]">
                      <span set:html={formatInlineHtml(line)} />
                    </p>
                  ))}
                </div>
              </div>
            );
          }
          return (
            <p class="font-serif text-base leading-[2.0] text-[#44382C]">
              <span set:html={formatInlineHtml(block.text)} />
            </p>
          );
        })}
      </div>

      <!-- Bottom Navigation Bar (Seal stamp removed per UX feedback) -->
      <footer class="mt-14 pt-8 border-t border-[#E5DDD0] flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="font-display text-xs text-[#8C7C6B]">
          MIMI GUITAR · 专栏教程
        </p>

        <div class="flex items-center gap-3">
          <a href="/article" class="btn text-xs py-1.5 inline-flex items-center gap-1.5">
            <span>←</span>
            <span>返回文章列表</span>
          </a>
        </div>
      </footer>
    </article>

    <!-- Related Articles Section -->
    {relatedArticles.length > 0 && (
      <section class="mt-12">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-1 h-5 rounded-full bg-[#C49A45]"></span>
          <h3 class="font-display text-xl font-bold text-[#24201D]">相关专栏导读</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {relatedArticles.map((rel) => (
            <a
              href={`/article/${rel.id}`}
              class="p-5 rounded-2xl bg-white border border-[#E5DDD0] hover:border-[#C49A45] hover:shadow-sm transition-all flex flex-col justify-between"
            >
              <div>
                <span class="text-[11px] font-bold text-[#C84B31] bg-[#C84B31]/10 px-2 py-0.5 rounded">
                  {rel.category}
                </span>
                <h4 class="font-display font-bold text-sm text-[#24201D] mt-2 line-clamp-2">
                  {rel.title}
                </h4>
              </div>
              <span class="mt-4 text-xs font-bold text-[#8A7151] inline-flex items-center gap-1">
                阅读全文 →
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <script>
    const btn = document.getElementById('copy-title-btn');
    if (btn) {
      btn.addEventListener('click', async () => {
        const title = btn.getAttribute('data-title') ?? '';
        try {
          await navigator.clipboard.writeText(title);
          const orig = btn.textContent;
          btn.textContent = '已复制！';
          setTimeout(() => {
            btn.textContent = orig;
          }, 2000);
        } catch {
          alert('未能访问剪贴板，请手动复制。');
        }
      });
    }
  </script>
</Base>
