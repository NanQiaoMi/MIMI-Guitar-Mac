---
import Base from '../../layouts/Base.astro';
import { db } from '../../lib/db';
import { DEMO_ARTICLES } from '../../lib/demoData';
import { withCatalogRead } from '../../lib/catalogReadGate';

const sort = Astro.url.searchParams.get('sort') === 'hot' ? 'hot' : 'new';
const rawPage = Astro.url.searchParams.get('page') ?? '1';
const parsedPage = /^\d+$/.test(rawPage) ? Number(rawPage) : 1;
let page = Number.isSafeInteger(parsedPage) && parsedPage > 0 ? parsedPage : 1;
const PAGE_SIZE = 9;
let total = 0;
let articles: any[] = [];
let articleSource: 'catalog' | 'demo' = 'catalog';

try {
  const orderBy = sort === 'hot' ? { views: 'desc' as const } : { createdAt: 'desc' as const };
  const [countResult, rowsResult] = await Promise.allSettled([
    withCatalogRead(() => db.article.count()),
    withCatalogRead(() => db.article.findMany({
      orderBy,
      skip: (page - 1) * PAGE_SIZE,
      take: PAGE_SIZE,
    })),
  ]);
  if (countResult.status === 'rejected') throw countResult.reason;
  if (rowsResult.status === 'rejected') throw rowsResult.reason;
  total = countResult.value;
  const catalogPageCount = Math.max(1, Math.ceil(total / PAGE_SIZE));
  const clampedPage = Math.min(page, catalogPageCount);
  articles = clampedPage === page ? rowsResult.value : await withCatalogRead(() => db.article.findMany({
    orderBy,
    skip: (clampedPage - 1) * PAGE_SIZE,
    take: PAGE_SIZE,
  }));
  page = clampedPage;
} catch {
  articleSource = 'demo';
  const sorted = [...DEMO_ARTICLES];
  if (sort === 'hot') sorted.sort((a, b) => b.views - a.views);
  else sorted.sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime());
  total = sorted.length;
  const demoPageCount = Math.max(1, Math.ceil(total / PAGE_SIZE));
  page = Math.min(page, demoPageCount);
  articles = sorted.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
}

const pageCount = Math.max(1, Math.ceil(total / PAGE_SIZE));

function excerpt(content: string): string {
  return content.replace(/\n+/g, ' ').trim();
}
function heatText(v: number): string {
  if (v >= 10000) return (v / 10000).toFixed(1) + '万';
  return String(v);
}
const pageHref = (p: number, s: string) => `/article?sort=${s}&page=${p}`;
---
<Base title="文章 - MIMI Guitar">
  <section class="border-b hairline pb-8">
    {articleSource === 'demo' && <p role="status" class="mb-4 rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">文章曲库暂时不可用，当前显示内置演示内容。</p>}
    <p class="text-caption tracking-[0.2em] uppercase text-ash">Editorial · Notes</p>
    <h1 class="font-display text-heading mt-2">文章</h1>
    <p class="mt-3 max-w-xl text-body-sm leading-relaxed text-charcoal">
      从零基础入门到进阶技巧，把练琴路上的经验整理成一篇篇短文。
    </p>
    <div class="mt-5 flex flex-wrap items-center gap-3">
      <div class="flex gap-2">
        <a href={pageHref(1, 'new')} class={"chip " + (sort === 'new' ? 'chip-active' : '')}>最新</a>
        <a href={pageHref(1, 'hot')} class={"chip " + (sort === 'hot' ? 'chip-active' : '')}>最热</a>
      </div>
      <a href="/publishArticle" class="btn ml-auto">发布文章</a>
    </div>
  </section>

  {articles.length > 0 ? (
    <>
      <ul class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {articles.map((a) => (
          <li>
            <a href={`/article/${a.id}`} class="card group block p-6 transition hover:opacity-80">
              <p class="text-caption text-ash">{a.category ?? '乐谱知识'} · {a.createdAt.toISOString().slice(0, 10)} · {heatText(a.views)} 热度</p>
              <h2 class="font-display text-subheading mt-2 leading-snug group-hover:text-signal">{a.title}</h2>
              <p class="mt-3 text-body-sm text-charcoal line-clamp-3">{excerpt(a.content).slice(0, 96)}…</p>
            </a>
          </li>
        ))}
      </ul>
      {pageCount > 1 && (
        <nav class="mt-8 flex items-center justify-center gap-2">
          {page > 1 && <a href={pageHref(page - 1, sort)} class="chip">上一页</a>}
          {Array.from({ length: pageCount }, (_, i) => i + 1).map((p) => (
            <a href={pageHref(p, sort)} class={"chip " + (p === page ? 'chip-active' : '')}>{p}</a>
          ))}
          {page < pageCount && <a href={pageHref(page + 1, sort)} class="chip">下一页</a>}
        </nav>
      )}
    </>
  ) : (
    <div class="card mt-8 flex h-40 items-center justify-center text-ash">文章整理中，敬请期待</div>
  )}
</Base>
