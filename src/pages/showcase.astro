---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.svelte';
import TabCard from '../components/TabCard.astro';
import TabCardGrid from '../components/TabCardGrid.svelte';
import FilterBar from '../components/FilterBar.astro';
import DifficultyMatrix from '../components/DifficultyMatrix.svelte';
import FavoriteButton from '../components/FavoriteButton.svelte';
import ShareButton from '../components/ShareButton.svelte';
import DownloadButton from '../components/DownloadButton.svelte';
import VirtualFretboard from '../components/VirtualFretboard.svelte';
import MusicNoteParticles from '../components/MusicNoteParticles.svelte';
import ShowcasePlayground from '../components/showcase/ShowcasePlayground.svelte';

const sampleTabsList = [
  {
    id: 'demo-tab-1',
    title: '晴天 (Sunny Day)',
    artist: '周杰伦 (Jay Chou)',
    category: 'guitar',
    key: 'G',
