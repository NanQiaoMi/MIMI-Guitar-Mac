    difficulty: 5,
    sheetForm: 2,
    heat: 21400,
    screenshotUrl: 'https://images.unsplash.com/photo-1525201548942-d8732f6617a0?w=300&auto=format&fit=crop&q=80',
  },
  {
    id: 'demo-tab-6',
    title: '海阔天空 (Boundless Oceans)',
    artist: 'Beyond',
    category: 'guitar',
    key: 'F',
    difficulty: 3,
    sheetForm: 4,
    heat: 29800,
    screenshotUrl: null,
  },
  {
    id: 'demo-tab-7',
    title: 'Aloha Oe (珍重再见)',
    artist: 'Liliʻuokalani',
    category: 'ukulele',
    key: 'F',
    difficulty: 2,
    sheetForm: 3,
    heat: 6400,
    screenshotUrl: null,
  },
  {
    id: 'demo-tab-8',
    title: '夜的第七章',
    artist: '周杰伦',
    category: 'guitar',
    key: 'Am',
    difficulty: 4,
    sheetForm: 4,
    heat: 38200,
    screenshotUrl: null,
  },
];

const sampleMatrixGuitar = {
  '1:1': 142,
  '1:2': 68,
  '1:3': 210,
  '1:4': 540,
  '2:1': 185,
  '2:2': 120,
  '2:3': 310,
  '2:4': 860,
  '3:1': 95,
  '3:2': 240,
  '3:3': 180,
  '3:4': 620,
  '4:1': 45,
  '4:2': 180,
  '4:3': 90,
  '4:4': 380,
  '5:1': 12,
  '5:2': 98,
  '5:3': 34,
  '5:4': 190,
};

const sampleMatrixUku = {
  '1:1': 210,
  '1:2': 45,
  '1:3': 340,
  '1:4': 280,
  '2:1': 180,
  '2:2': 62,
  '2:3': 220,
  '2:4': 190,
  '3:1': 76,
  '3:2': 88,
  '3:3': 110,
  '3:4': 140,
  '4:1': 25,
  '4:2': 40,
  '4:3': 50,
  '4:4': 65,
  '5:1': 8,
  '5:2': 19,
  '5:3': 15,
  '5:4': 28,
};
---

<Base title="UI & Motion Design Showcase · MIMI Guitar">
  <div class="space-y-16">
    <!-- Showcase Top Banner -->
    <div class="border-b hairline pb-6">
      <div class="inline-flex items-center gap-2 rounded-pill border hairline bg-surface-alt px-3 py-1 text-caption text-charcoal mb-3">
        <span class="h-2 w-2 rounded-full bg-signal animate-pulse"></span>
        <span>Design System · refero-styles Ui</span>
      </div>
      <h1 class="font-display text-heading-lg text-ink">全站高级 UI 与动效全家桶 Showcase</h1>
      <p class="mt-2 text-body-sm text-mid-gray max-w-3xl leading-relaxed">
        这里汇集站内预置的界面与交互动效示例，可试用曲库筛选、指板演示与纸页转场。展示曲目和数字均为内置示例，不代表实时目录统计；实际动画表现会随设备、浏览器和动效偏好变化。
      </p>
    </div>

    <!-- 0. 全功能全家桶交互展台 (ShowcasePlayground.svelte) -->
    <section>
      <ShowcasePlayground client:load />
    </section>

    <!-- 1. 3D Holographic Foil Cards Showcase -->
    <section>
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="font-display text-heading-sm text-ink">1. 3D Holographic Foil Cards (全息彩虹箔面与光斑折射)</h2>
          <p class="text-caption text-mid-gray mt-0.5"><code>.holo-card</code> & <code>.holo-foil</code> 多层折射微光 · 鼠标滑过呈现全息彩虹折射与动态微倾斜</p>
        </div>
        <span class="inline-flex items-center gap-1 rounded-pill border hairline bg-surface-alt px-3 py-1 text-caption text-signal">
          <span>★ 3D PARALLAX</span>
        </span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <TabCard tab={sampleTabsList[0]} featured={true} />
        <TabCard tab={sampleTabsList[1]} />
        <TabCard tab={sampleTabsList[3]} />
        <TabCard tab={sampleTabsList[4]} />
      </div>
    </section>

    <!-- 2. Masterpiece Cinema Intro Interactive Trigger Panel -->
    <section>
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="font-display text-heading-sm text-ink">2. Masterpiece Cinema Intro (电影级开场幕帘交互面板)</h2>
          <p class="text-caption text-mid-gray mt-0.5">Karplus-Strong 吉他拨弦共鸣 + 傅里叶谐波 6 弦驻波 + Iris 极速圆形无缝擦除转场</p>
        </div>
      </div>
      <div class="card rounded-card border hairline bg-gradient-to-r from-[#17171d] to-[#0a0a0f] text-white p-6 sm:p-8 shadow-md">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 rounded-pill border border-[#f5c07b]/30 bg-[#f5c07b]/10 px-3 py-0.5 text-caption font-mono text-[#f5c07b]">
              <span class="h-2 w-2 rounded-full bg-[#f5c07b] animate-pulse"></span>
              <span>CINEMATIC OPENING ENGINE</span>
            </div>
            <h3 class="font-display text-xl sm:text-2xl text-white">电影级开场物理驻波与动力学字距</h3>
            <p class="text-body-sm text-white/70 max-w-xl">
              点击下方按钮通过全局 <code>mimi:play-intro</code> 事件重新体验电影级开场，支持吉他琴弦自由拨奏、动态扫光掠影与阻尼阻尼平滑收束。
            </p>
          </div>
          <button
            type="button"
            onclick="sessionStorage.removeItem('mimi_intro_played'); window.dispatchEvent(new CustomEvent('mimi:play-intro'));"
            class="inline-flex items-center gap-2 rounded-pill border border-[#f5c07b]/60 bg-gradient-to-r from-[#f5c07b]/20 to-[#41a1cf]/20 px-6 py-3 text-body-sm font-semibold text-white shadow-[0_0_25px_rgba(245,192,123,0.3)] backdrop-blur-xl transition hover:scale-105 hover:border-[#f5c07b] active:scale-95 cursor-pointer shrink-0"
          >
            <span>🎬 立即播放全屏电影开场</span>
          </button>
        </div>
      </div>
    </section>

    <!-- 3. Virtual Fretboard Live Lab -->
    <section>
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-display text-heading-sm text-ink">3. Virtual Fretboard 物理吉他指板与音符光晕</h2>
        <span class="text-caption text-mid-gray">Web Audio API 真实物理合成扫弦 · 6弦 / 4弦双模</span>
      </div>
      <div class="card rounded-card border hairline bg-paper p-6 shadow-xs">
        <VirtualFretboard client:load initialChord="C" fretsCount={15} instrument="guitar" />
      </div>
    </section>

    <!-- 4. TabCardGrid (50ms Stagger & FLIP Animated Grid) -->
    <section>
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="font-display text-heading-sm text-ink">4. TabCardGrid 动态排版与 FLIP 弹簧过渡 (TabCardGrid.svelte)</h2>
        <span class="text-caption text-mid-gray">50ms 级联微波 + Svelte 5 Runes 响应式过渡</span>
      </div>
      <TabCardGrid
        client:load
        tabs={sampleTabsList}
        initialCategory="all"
        showFilters={true}
        showSearch={true}
        staggerDelay={50}
      />
    </section>

    <!-- 5. Hero Showcase with Blur-Up & Particles -->
    <section>
      <h2 class="font-display text-heading-sm text-ink mb-4">5. Hero 聚光灯、音符粒子与 Blur-Up 电影级进场 (Hero.svelte)</h2>
      <Hero client:load totalTabs={3890} />
    </section>

    <!-- 6. Micro-interactions: Favorite & Share & Download Buttons -->
    <section>
      <h2 class="font-display text-heading-sm text-ink mb-4">6. 微交互反馈：红心粒子爆炸与磨砂 Toast (FavoriteButton & ShareButton)</h2>
      <div class="card rounded-card border hairline bg-paper p-6 shadow-xs">
        <p class="text-caption text-mid-gray mb-4">点击下方按钮测试红心微爆炸粒子动效与剪贴板复制 Toast 提示：</p>
        <div class="flex flex-wrap items-center gap-4">
          <FavoriteButton client:load tabId="demo-tab-1" initialCount={128} />
          <ShareButton client:load />
          <DownloadButton client:load tabId="demo-tab-1" />
        </div>
      </div>
    </section>

    <!-- 7. FilterBar Showcase -->
    <section>
      <h2 class="font-display text-heading-sm text-ink mb-4">7. 18px 胶囊几何筛选栏 (FilterBar.astro)</h2>
      <FilterBar
        category="tabs"
        current={{ difficulty: 2, style: 101, sort: 1 }}
        title="吉他曲谱库筛选演示"
      />
    </section>

    <!-- 8. DifficultyMatrix Showcase -->
    <section>
      <h2 class="font-display text-heading-sm text-ink mb-4">8. 5 段发光 Pip 难度矩阵 (DifficultyMatrix.svelte)</h2>
      <DifficultyMatrix client:load guitar={sampleMatrixGuitar} ukulele={sampleMatrixUku} />
    </section>
  </div>
</Base>


