    featured: true,
  },
  {
    id: 'demo-tab-2',
    title: '加州旅馆 (Hotel California)',
    artist: 'Eagles',
    category: 'guitar',
    key: 'Bm',
    difficulty: 4,
    sheetForm: 2,
    heat: 45200,
    screenshotUrl: 'https://images.unsplash.com/photo-1510915361894-db8b60106cb1?w=300&auto=format&fit=crop&q=80',
  },
  {
