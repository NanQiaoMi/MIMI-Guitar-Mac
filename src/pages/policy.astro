---
import Base from '../layouts/Base.astro';

const sections = [
  ['引言', '我们非常重视你的隐私与个人信息保护。本政策说明 MIMI Guitar（下称"本站"）在提供服务过程中可能收集的信息、使用方式以及你的相关权利。'],
  ['一、我们可能收集的信息', '在未登录状态下，本站可以正常浏览与播放全部曲谱，不要求提供任何个人信息。仅当你使用收藏、浏览记录同步、上传等功能时，可能涉及账号信息（邮箱或手机号、昵称、头像）与操作记录（收藏列表、上传记录）。'],
  ['二、信息收集的用途及使用规则', '我们收集的信息仅用于：提供并优化曲谱浏览与播放服务、保存你的收藏与上传记录、在你请求时与你联系。浏览记录默认保存在你的本地设备（浏览器 localStorage）中，不会上传服务器。'],
  ['三、信息的共享、转让及披露', '我们不会出售你的个人信息。除法律法规要求、或为保障本站运行所必需的服务提供商外，我们不会向第三方共享你的个人信息。'],
  ['四、我们的信息安全保护', '我们采用合理的技术与管理措施保护信息存储安全，包括密码哈希存储、传输加密等。但请注意，任何网络传输与存储方式都无法保证绝对安全。'],
  ['五、未成年人信息保护', '若你为未成年人，请在监护人指导下使用本站。我们不会主动收集未成年人的个人信息。'],
  ['六、免责条款', '本站为学习与演示用途的复刻项目，所展示曲谱内容来自公开渠道迁移的演示数据。因使用本站内容产生的任何直接或间接损失，本站不承担相应责任。'],
  ['七、本政策的适用范围', '本政策适用于本站提供的全部页面与服务。若本站接入第三方服务，其隐私规则以第三方公示为准。'],
  ['八、如何联系我们', '如对本政策有任何疑问，或希望查询、更正、删除你的个人信息，请通过「联系我们」页面与我们取得联系。'],
];
---

<Base title="隐私政策 - MIMI Guitar">
  <article class="max-w-3xl">
    <p class="text-caption tracking-[0.2em] uppercase text-ash">Privacy</p>
    <h1 class="font-display text-heading mt-2">隐私政策</h1>
    <div class="mt-8 space-y-6">
      {sections.map(([t, body]) => (
        <section>
          <h2 class="font-display text-subheading">{t}</h2>
          <p class="mt-2 text-body-sm leading-[1.9] text-charcoal">{body}</p>
        </section>
      ))}
    </div>
  </article>
</Base>