---
import Base from '../layouts/Base.astro';

const sections = [
  ['一、服务说明', '本站（MIMI Guitar）为「谱全了」guistudy.com 的全站功能复刻学习项目，提供吉他谱与尤克里里谱的浏览、显示、在线播放与上传等服务。注册并使用本站服务，即表示你已阅读、理解并同意本协议的全部条款。'],
  ['二、账号与安全', '你应妥善保管账号密码，并对其名下账号产生的全部行为负责。若发现账号被他人盗用或存在安全漏洞，请及时通过「联系我们」告知我们。'],
  ['三、内容与版权', '站内曲谱内容来自公开渠道迁移的演示数据，著作权归原作者与上传者所有。上传者应保证其上传内容不侵犯第三方合法权益；如涉及侵权，我们将在核实后依法处理。'],
  ['四、用户行为规范', '不得利用本站从事任何违反法律法规或损害他人权益的行为，包括但不限于：上传违法内容、批量抓取数据、攻击服务器、滥用下载或播放接口等。'],
  ['五、服务的变更与中断', '我们可能根据需要对服务内容、功能进行调整，或对服务进行维护。因维护、升级、不可抗力等原因导致服务中断的，本站不承担由此产生的责任。'],
  ['六、免责声明', '本站为学习与演示用途的项目，不对内容的准确性、完整性与可用性作出任何明示或默示的保证。因使用本站内容产生的损失，本站不承担相应责任。'],
  ['七、协议的修改', '我们可能适时修订本协议，修订后的协议将在本站公布。继续使用本站服务即视为接受修订后的协议。'],
  ['八、争议解决', '因本协议产生的争议，双方应友好协商解决；协商不成的，依法向有管辖权的人民法院提起诉讼。'],
];
---

<Base title="用户协议 - MIMI Guitar">
  <article class="max-w-3xl">
    <p class="text-caption tracking-[0.2em] uppercase text-ash">Agreement</p>
    <h1 class="font-display text-heading mt-2">用户协议</h1>
    <div class="mt-8 space-y-6">
      {sections.map(([t, body]) => (
        <section>
          <h2 class="font-display text-subheading">{t}</h2>
          <p class="mt-2 text-body-sm leading-[1.9] text-charcoal">{body}</p>
        </section>
      ))}
    </div>
  </article>
</Base>
