---
import Base from '../layouts/Base.astro';
import AuthForm from '../components/AuthForm.svelte';
---

<Base title="注册 - MIMI Guitar">
  <div class="mx-auto max-w-md">
    <div class="card p-8">
      <p class="text-caption tracking-[0.2em] uppercase text-ash">Sign up</p>
      <h1 class="font-display text-heading-sm mt-2">注册 MIMI Guitar</h1>
      <p class="mt-2 text-body-sm text-ash">使用手机号或邮箱注册，收藏与上传功能全站开放。</p>
      <div class="mt-6">
        <AuthForm client:load mode="register" />
      </div>
    </div>
  </div>
</Base>