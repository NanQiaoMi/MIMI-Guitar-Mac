---
import Base from '../layouts/Base.astro';
import AuthForm from '../components/AuthForm.svelte';
---

<Base title="登录 - MIMI Guitar">
  <div class="mx-auto max-w-md">
    <div class="card p-8">
      <p class="text-caption tracking-[0.2em] uppercase text-ash">Sign in</p>
      <h1 class="font-display text-heading-sm mt-2">登录 MIMI Guitar</h1>
      <p class="mt-2 text-body-sm text-ash">登录后可收藏曲谱、同步浏览记录与上传作品。</p>
      <div class="mt-6">
        <AuthForm client:load mode="login" />
      </div>
    </div>
  </div>
</Base>